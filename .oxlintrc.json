{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error"
  },
  "env": {
    "browser": true,
    "node": true
  },
  "ignorePatterns": ["dist/**", "node_modules/**", "coverage/**"],
  "options": {
    "denyWarnings": true
  },
  "rules": {
    "no-use-before-define": ["error", { "functions": false, "classes": false, "variables": true }]
  }
}
