{
  "name": "frameyard",
  "version": "0.3.0",
  "description": "Local-first, deterministic video composition framework for HTML, CSS, and JavaScript.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vladiantio/frameyard.git"
  },
  "homepage": "https://github.com/vladiantio/frameyard#readme",
  "bugs": {
    "url": "https://github.com/vladiantio/frameyard/issues"
  },
  "keywords": [
    "video",
    "video-rendering",
    "html",
    "css",
    "javascript",
    "deterministic",
    "ffmpeg",
    "playwright",
    "agent-skill"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "frameyard": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "default": "./dist/runtime/index.js"
    }
  },
  "files": [
    "dist",
    "examples",
    "docs",
    "skills",
    "README.md",
    "CHANGELOG.md",
    "GLOSSARY.md"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "check:scripts": "node scripts/check-scripts.mjs",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check:static": "pnpm check:scripts && pnpm lint && pnpm format:check && pnpm typecheck && pnpm typecheck:test",
    "check": "pnpm check:static && pnpm test",
    "test": "pnpm build && vitest run",
    "test:unit": "vitest run test/contracts.test.ts test/docs.test.ts test/random.test.ts test/release.test.ts test/scaffold.test.ts test/transcript.test.ts",
    "bench": "pnpm build && node scripts/bench-render.mjs",
    "set-version": "node scripts/set-version.mjs",
    "verify-release": "node scripts/verify-release.mjs",
    "prepare": "node scripts/install-hooks.mjs",
    "prepublishOnly": "node scripts/check-package-manager.mjs && pnpm build"
  },
  "dependencies": {
    "playwright": "1.64.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@12.15.0"
}
