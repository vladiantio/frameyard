{
  "name": "frameyard",
  "version": "0.12.1",
  "description": "Local-first, deterministic video composition framework for HTML, CSS, and JavaScript.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vladiantio/frameyard.git"
  },
  "homepage": "https://github.com/vladiantio/frameyard#readme",
  "bugs": {
    "url": "https://github.com/vladiantio/frameyard/issues"
  },
  "keywords": [
    "video",
    "video-rendering",
    "html",
    "css",
    "javascript",
    "deterministic",
    "ffmpeg",
    "playwright",
    "agent-skill"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "frameyard": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "default": "./dist/runtime/index.js"
    }
  },
  "files": [
    "dist",
    "examples",
    "docs",
    "scaffolds",
    "skills",
    "README.md",
    "CHANGELOG.md",
    "GLOSSARY.md"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-preview-fonts.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "typecheck:browser": "tsc -p tsconfig.browser.json",
    "check:scripts": "node scripts/check-scripts.mjs",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check:static": "pnpm check:scripts && pnpm lint && pnpm format:check && pnpm build && pnpm typecheck:test && pnpm typecheck:browser",
    "compare-stills": "node scripts/compare-stills.mjs",
    "check": "pnpm check:static && pnpm test:built && node scripts/check-stamp.mjs record",
    "check:preview": "pnpm check:static && vitest run test/preview-runtime.test.ts test/timeline-preview.test.ts test/timeline-preview-runtime.test.ts",
    "check:changelog": "node scripts/check-changelog.mjs",
    "test": "pnpm build && vitest run",
    "test:built": "vitest run",
    "test:integration": "pnpm build && vitest run --project integration",
    "test:examples": "pnpm build && vitest run test/examples.test.ts",
    "test:preview": "pnpm build && vitest run test/preview-runtime.test.ts test/timeline-preview.test.ts test/timeline-preview-runtime.test.ts",
    "test:unit": "vitest run --project unit",
    "bench": "pnpm build && node scripts/bench-render.mjs",
    "bench:static": "pnpm build && node bench/static-composition.mjs",
    "eval:local": "node evals/runner.mjs",
    "set-version": "node scripts/set-version.mjs",
    "verify-release": "node scripts/verify-release.mjs",
    "verify-package": "node scripts/verify-package.mjs",
    "retag-release": "node scripts/retag-release.mjs",
    "prepare": "node scripts/install-hooks.mjs",
    "prepublishOnly": "node scripts/check-package-manager.mjs && pnpm build"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "citty": "^0.2.2",
    "parse5": "^8.0.1",
    "picocolors": "^1.1.1",
    "playwright": "1.64.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@12.15.0"
}
